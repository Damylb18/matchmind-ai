# Copy to api/.env (git-ignored) and fill in. Never commit a real key.
# Without OPENAI_ENABLED=true and a key, the app uses its rule-based text and local templates.

OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Hosting providers such as Render set PORT automatically. Defaults to 4000 locally.
# PORT=4000

# Optional limits (defaults shown)
# OPENAI_MAX_CALLS_PER_MATCH=10        # narratives + the two recaps
# OPENAI_MAX_INSIGHT_CALLS=8           # capped at MAX_CALLS_PER_MATCH - 2
# OPENAI_TEAM_GAP_SECONDS=600          # match seconds between narratives for the same team
# OPENAI_TIMEOUT_MS=30000              # per insight narrative request
# OPENAI_RECAP_TIMEOUT_MS=60000        # per recap request
# OPENAI_MAX_OUTPUT_TOKENS=2000
# OPENAI_RECAP_MAX_OUTPUT_TOKENS=3500
# OPENAI_MIN_INTERVAL_MS=2000          # spacing between OpenAI calls
# OPENAI_QUEUE_SIZE=3                  # narrative requests waiting at most

# Demo timing overrides (defaults: 1000 ms per event, 15 s half-time break)
# EVENT_INTERVAL_MS=1000
# HALF_TIME_BREAK_MS=15000
